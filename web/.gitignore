# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-codex-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.codex-server-*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/.next-redesign/

# Cygwin/MSYS crash dumps. Load-bearing: Tailwind v4's automatic source
# detection honours .gitignore, and without this it tries to scan a dump that
# is still locked by the crashing process — which panics Turbopack and makes
# every route 500 until the file is deleted.
*.stackdump
